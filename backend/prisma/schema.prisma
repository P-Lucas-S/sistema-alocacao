generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @db.VarChar(191)
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(50)
  position     String   @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.LongText
  createdAt    DateTime @default(now()) @map("created_at")

  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  passwordResets       PasswordReset[]
  projetos             Projeto[]
  colaboradoresCriados Colaborador[]

  @@map("users")
}

model Notification {
  id        String   @id @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @db.VarChar(50)
  taskId    String?  @map("task_id") @db.VarChar(191)
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  endpoint  String   @db.Text
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_subscriptions")
}

model PasswordReset {
  id        String   @id @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

// ─── Fase 1: Domínio de Alocação ──────────────────────────────────

model Colaborador {
  id          String   @id @db.VarChar(191)
  nome        String   @db.VarChar(255)
  email       String   @unique @db.VarChar(255)
  funcao      String?  @db.VarChar(100)
  ativo       Boolean  @default(true)
  createdById String   @map("created_by_id") @db.VarChar(191)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("colaboradores")
}

model Projeto {
  id        String   @id @db.VarChar(191)
  codigo    String   @unique @db.VarChar(50)
  nome      String   @db.VarChar(255)
  gestorId  String   @map("gestor_id") @db.VarChar(191)
  status    String   @default("ativo") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gestor            User               @relation(fields: [gestorId], references: [id])
  macroEntregas     MacroEntrega[]
  prestacoesContas  PrestacaoContas[]

  @@map("projetos")
}

model PrestacaoContas {
  id        String   @id @db.VarChar(191)
  projetoId String   @map("projeto_id") @db.VarChar(191)
  data      DateTime @db.Date

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("prestacoes_contas")
}

model MacroEntrega {
  id        String    @id @db.VarChar(191)
  projetoId String    @map("projeto_id") @db.VarChar(191)
  nome      String    @db.VarChar(255)
  descricao String?   @db.Text
  deadline  DateTime?
  status    String    @default("ativa") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  projeto       Projeto        @relation(fields: [projetoId], references: [id])
  microEntregas MicroEntrega[]

  @@map("macro_entregas")
}

model MicroEntrega {
  id             String    @id @db.VarChar(191)
  macroEntregaId String    @map("macro_entrega_id") @db.VarChar(191)
  nome           String    @db.VarChar(255)
  descricao      String?   @db.Text
  deadline       DateTime?
  status         String    @default("pendente") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  macroEntrega MacroEntrega @relation(fields: [macroEntregaId], references: [id])

  @@map("micro_entregas")
}
