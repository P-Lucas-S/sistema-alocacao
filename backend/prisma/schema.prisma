generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @db.VarChar(191)
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(50)
  position     String   @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.LongText
  createdAt    DateTime @default(now()) @map("created_at")

  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  passwordResets       PasswordReset[]
  projetosGeridos      Projeto[]          @relation("ProjetoGestor")
  projetosCriados      Projeto[]          @relation("ProjetoCriadoPor")
  colaboradoresCriados Colaborador[]
  alocacoesCriadas     Alocacao[]         @relation("AlocacaoCreatedBy")
  alocacoesAtualizadas Alocacao[]         @relation("AlocacaoUpdatedBy")
  fechamentosMensais                  FechamentoMensal[]          @relation("FechamentoMensalFechadoPor")
  alocacaoLogs                        AlocacaoLog[]               @relation("AlocacaoLogUsuario")
  solicitacoesRemanejamentoFeitas     SolicitacaoRemanejamento[]  @relation("SolicitacaoRemanejamentoSolicitante")
  solicitacoesRemanejamentoEncerradas SolicitacaoRemanejamento[]  @relation("SolicitacaoRemanejamentoFechadoPor")
  cessoesCedidas                      CessaoRemanejamento[]       @relation("CessaoRemanejamentoGestorCedente")
  redelegacoesFeitas                  Redelegacao[]               @relation("RedelegacaoRedelegadoPor")
  projetosExclusaoSolicitada          Projeto[]                   @relation("ProjetoExclusaoSolicitadaPor")
  exclusoesSolicitadas                ProjetoExcluido[]            @relation("ProjetoExcluidoSolicitante")
  exclusoesAprovadas                  ProjetoExcluido[]            @relation("ProjetoExcluidoAprovador")

  @@map("users")
}

model Notification {
  id        String   @id @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @db.VarChar(50)
  taskId    String?  @map("task_id") @db.VarChar(191)
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  endpoint  String   @db.Text
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_subscriptions")
}

model PasswordReset {
  id        String   @id @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

// ─── Fase 1: Domínio de Alocação ──────────────────────────────────

model CategoriaProjeto {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projetos  Projeto[]
  tarifas   TarifaColaborador[]

  @@map("categorias_projeto")
}

model AreaAtuacao {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("areas_atuacao")
}

model TarifaColaborador {
  id            String   @id @default(cuid())
  colaboradorId String
  categoriaId   String
  valorHora     Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  colaborador   Colaborador      @relation(fields: [colaboradorId], references: [id], onDelete: Restrict)
  categoria     CategoriaProjeto @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@unique([colaboradorId, categoriaId])
  @@index([categoriaId])
  @@map("tarifas_colaborador")
}

model Colaborador {
  id          String   @id @db.VarChar(191)
  nome        String   @db.VarChar(255)
  email       String   @unique @db.VarChar(255)
  funcao      String?  @db.VarChar(100)
  valorHora   Decimal? @map("valor_hora") @db.Decimal(10, 2)
  ativo       Boolean  @default(true)
  createdById String   @map("created_by_id") @db.VarChar(191)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy                 User                       @relation(fields: [createdById], references: [id])
  alocacoes                 Alocacao[]
  solicitacoesRemanejamento SolicitacaoRemanejamento[] @relation("SolicitacaoRemanejamentoColaborador")
  tarifas                   TarifaColaborador[]

  @@map("colaboradores")
}

model Projeto {
  id                      String   @id @db.VarChar(191)
  codigo                  String   @unique @db.VarChar(50)
  nome                    String   @db.VarChar(255)
  gestorId                String   @map("gestor_id") @db.VarChar(191)
  criadoPorId             String   @map("criado_por_id") @db.VarChar(191)
  categoriaId             String?
  status                  String   @default("ativo") @db.VarChar(50)
  exclusaoSolicitadaPorId String?  @map("exclusao_solicitada_por_id") @db.VarChar(191)
  motivoExclusao          String?  @map("motivo_exclusao") @db.Text
  statusAnteriorExclusao  String?  @map("status_anterior_exclusao") @db.VarChar(50)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  gestor                           User                       @relation("ProjetoGestor", fields: [gestorId], references: [id])
  criadoPor                        User                       @relation("ProjetoCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  exclusaoSolicitadaPor            User?                      @relation("ProjetoExclusaoSolicitadaPor", fields: [exclusaoSolicitadaPorId], references: [id], onDelete: Restrict)
  categoria                        CategoriaProjeto?          @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  macroEntregas                    MacroEntrega[]
  prestacoesContas                 PrestacaoContas[]
  alocacoes                        Alocacao[]
  solicitacoesDestinoRemanejamento SolicitacaoRemanejamento[] @relation("SolicitacaoRemanejamentoProjetoDestino")

  @@map("projetos")
}

model PrestacaoContas {
  id        String   @id @db.VarChar(191)
  projetoId String   @map("projeto_id") @db.VarChar(191)
  data      DateTime @db.Date

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("prestacoes_contas")
}

model MacroEntrega {
  id        String    @id @db.VarChar(191)
  projetoId String    @map("projeto_id") @db.VarChar(191)
  nome      String    @db.VarChar(255)
  descricao String?   @db.Text
  deadline  DateTime?
  status    String    @default("ativa") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  projeto                          Projeto                    @relation(fields: [projetoId], references: [id])
  microEntregas                    MicroEntrega[]
  alocacoes                        Alocacao[]
  solicitacoesDestinoRemanejamento SolicitacaoRemanejamento[] @relation("SolicitacaoRemanejamentoMacroDestino")

  @@map("macro_entregas")
}

model MicroEntrega {
  id             String    @id @db.VarChar(191)
  macroEntregaId String    @map("macro_entrega_id") @db.VarChar(191)
  nome           String    @db.VarChar(255)
  descricao      String?   @db.Text
  deadline       DateTime?
  status         String    @default("pendente") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  macroEntrega                     MacroEntrega               @relation(fields: [macroEntregaId], references: [id])
  alocacoes                        Alocacao[]
  solicitacoesDestinoRemanejamento SolicitacaoRemanejamento[] @relation("SolicitacaoRemanejamentoMicroDestino")

  @@map("micro_entregas")
}

// ─── Fase 2: Alocação mensal com teto ─────────────────────────────

model Alocacao {
  id              String   @id @db.VarChar(191)
  colaboradorId   String   @map("colaborador_id") @db.VarChar(191)
  projetoId       String   @map("projeto_id") @db.VarChar(191)
  macroEntregaId  String   @map("macro_entrega_id") @db.VarChar(191)
  microEntregaId  String   @map("micro_entrega_id") @db.VarChar(191)
  ano             Int
  mes             Int      // 1–12; validado na camada de aplicação
  horasPlanejadas Decimal  @map("horas_planejadas") @db.Decimal(6, 2)
  horasRealizadas Decimal? @map("horas_realizadas") @db.Decimal(6, 2)  // nullable — preenchido no C3
  createdById     String   @map("created_by_id") @db.VarChar(191)
  updatedById     String   @map("updated_by_id") @db.VarChar(191)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  colaborador  Colaborador  @relation(fields: [colaboradorId],  references: [id])
  projeto      Projeto      @relation(fields: [projetoId],      references: [id])
  macroEntrega MacroEntrega @relation(fields: [macroEntregaId], references: [id])
  microEntrega MicroEntrega @relation(fields: [microEntregaId], references: [id])
  createdBy    User         @relation("AlocacaoCreatedBy", fields: [createdById], references: [id])
  updatedBy    User         @relation("AlocacaoUpdatedBy", fields: [updatedById], references: [id])

  // Chave natural: um colaborador tem no máximo uma alocação por micro/mês
  @@unique([colaboradorId, projetoId, macroEntregaId, microEntregaId, ano, mes])
  // Índice crítico: toda verificação de teto soma por (colaborador, ano, mes)
  @@index([colaboradorId, ano, mes])
  @@map("alocacoes")
}

// ─── Fase 3: Fechamento mensal (read-only lock) + log de auditoria ─

model FechamentoMensal {
  id           String   @id @db.VarChar(191)
  ano          Int
  mes          Int
  fechadoPorId String   @map("fechado_por_id") @db.VarChar(191)
  fechadoEm    DateTime @default(now()) @map("fechado_em")

  fechadoPor User @relation("FechamentoMensalFechadoPor", fields: [fechadoPorId], references: [id])

  @@unique([ano, mes])
  @@map("fechamentos_mensais")
}

model AlocacaoLog {
  id              String   @id @db.VarChar(191)
  alocacaoId      String   @map("alocacao_id") @db.VarChar(191)
  colaboradorId   String   @map("colaborador_id") @db.VarChar(191)
  projetoId       String   @map("projeto_id") @db.VarChar(191)
  macroEntregaId  String   @map("macro_entrega_id") @db.VarChar(191)
  microEntregaId  String   @map("micro_entrega_id") @db.VarChar(191)
  ano             Int
  mes             Int
  acao            String   @db.VarChar(20)
  horasAnteriores Decimal? @map("horas_anteriores") @db.Decimal(6, 2)
  horasNovas      Decimal? @map("horas_novas") @db.Decimal(6, 2)
  usuarioId       String   @map("usuario_id") @db.VarChar(191)
  cessaoId        String?  @map("cessao_id") @db.VarChar(191)
  criadoEm        DateTime @default(now()) @map("criado_em")

  usuario User @relation("AlocacaoLogUsuario", fields: [usuarioId], references: [id])

  @@index([alocacaoId])
  @@map("alocacao_logs")
}

// ─── Fase 4: Remanejamento broadcast ──────────────────────────────

model SolicitacaoRemanejamento {
  id                    String    @id @db.VarChar(191)
  solicitanteId         String    @map("solicitante_id") @db.VarChar(191)
  colaboradorId         String    @map("colaborador_id") @db.VarChar(191)
  projetoDestinoId      String    @map("projeto_destino_id") @db.VarChar(191)
  macroEntregaDestinoId String    @map("macro_entrega_destino_id") @db.VarChar(191)
  microEntregaDestinoId String    @map("micro_entrega_destino_id") @db.VarChar(191)
  ano                   Int
  mes                   Int
  horasSolicitadas      Decimal   @map("horas_solicitadas") @db.Decimal(6, 2)
  status                String    @db.VarChar(20)
  fechadoEm             DateTime? @map("fechado_em")
  fechadoPorId          String?   @map("fechado_por_id") @db.VarChar(191)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  solicitante         User         @relation("SolicitacaoRemanejamentoSolicitante",   fields: [solicitanteId],         references: [id])
  colaborador         Colaborador  @relation("SolicitacaoRemanejamentoColaborador",   fields: [colaboradorId],         references: [id])
  projetoDestino      Projeto      @relation("SolicitacaoRemanejamentoProjetoDestino", fields: [projetoDestinoId],     references: [id])
  macroEntregaDestino MacroEntrega @relation("SolicitacaoRemanejamentoMacroDestino",  fields: [macroEntregaDestinoId], references: [id])
  microEntregaDestino MicroEntrega @relation("SolicitacaoRemanejamentoMicroDestino",  fields: [microEntregaDestinoId], references: [id])
  fechadoPor          User?        @relation("SolicitacaoRemanejamentoFechadoPor",    fields: [fechadoPorId],          references: [id], onDelete: Restrict)
  cessoes             CessaoRemanejamento[]

  @@index([colaboradorId, ano, mes, status])
  @@map("solicitacoes_remanejamento")
}

model CessaoRemanejamento {
  id                   String   @id @db.VarChar(191)
  solicitacaoId        String   @map("solicitacao_id") @db.VarChar(191)
  gestorCedenteId      String   @map("gestor_cedente_id") @db.VarChar(191)
  horasCedidas         Decimal  @map("horas_cedidas") @db.Decimal(6, 2)
  idempotencia         String   @unique @db.VarChar(191)
  alocacaoOrigemId     String   @map("alocacao_origem_id") @db.VarChar(191)
  origemProjetoId      String   @map("origem_projeto_id") @db.VarChar(191)
  origemMacroEntregaId String   @map("origem_macro_entrega_id") @db.VarChar(191)
  origemMicroEntregaId String   @map("origem_micro_entrega_id") @db.VarChar(191)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  solicitacao   SolicitacaoRemanejamento @relation(fields: [solicitacaoId],   references: [id])
  gestorCedente User                     @relation("CessaoRemanejamentoGestorCedente", fields: [gestorCedenteId], references: [id])

  @@map("cessoes_remanejamento")
}

// ─── Spec_Papeis_Posse_Exclusao: re-delegação de projeto ──────────
// Auditoria de quando o chefe troca o gestorId de um projeto. Contexto
// denormalizado (projetoId/gestorAnteriorId/gestorNovoId sem FK) no mesmo
// padrão de AlocacaoLog.alocacaoId — sobrevive à deleção do projeto (passo 5).
// Só redelegadoPorId (quem fez, o chefe) tem FK, porque User nunca é apagado
// por este fluxo.
model Redelegacao {
  id               String   @id @db.VarChar(191)
  projetoId        String   @map("projeto_id") @db.VarChar(191)
  gestorAnteriorId String   @map("gestor_anterior_id") @db.VarChar(191)
  gestorNovoId     String   @map("gestor_novo_id") @db.VarChar(191)
  redelegadoPorId  String   @map("redelegado_por_id") @db.VarChar(191)
  criadoEm         DateTime @default(now()) @map("criado_em")

  redelegadoPor User @relation("RedelegacaoRedelegadoPor", fields: [redelegadoPorId], references: [id], onDelete: Restrict)

  @@index([projetoId])
  @@map("redelegacoes")
}

// ─── Spec_Papeis_Posse_Exclusao: lápide de projeto excluído ────────
// Gravada ANTES do delete físico do projeto (passo 5, fora deste sub-passo).
// codigo NÃO é unique: o projeto morre, o código volta a ficar livre, e pode
// ser reusado e excluído de novo — cada exclusão é uma lápide independente.
// projetoIdOriginal/gestorIdOriginal/criadoPorIdOriginal são colunas simples
// SEM FK (o projeto e potencialmente os usuários originais já não existem
// mais como entidades referenciáveis no momento da consulta futura) — mesmo
// padrão denormalizado de AlocacaoLog/Redelegacao. Só solicitanteId (pode ser
// null — exclusão direta do chefe sem pedido prévio) e aprovadorId (o chefe
// que executou) apontam pra User vivo, com FK.
model ProjetoExcluido {
  id                  String    @id @db.VarChar(191)
  codigo              String    @db.VarChar(50)
  nome                String    @db.VarChar(255)
  projetoIdOriginal   String    @map("projeto_id_original") @db.VarChar(191)
  gestorIdOriginal    String    @map("gestor_id_original") @db.VarChar(191)
  criadoPorIdOriginal String    @map("criado_por_id_original") @db.VarChar(191)
  solicitanteId       String?   @map("solicitante_id") @db.VarChar(191)
  aprovadorId         String    @map("aprovador_id") @db.VarChar(191)
  motivo              String?   @db.Text
  criadoEmOriginal    DateTime? @map("criado_em_original")
  excluidoEm          DateTime  @default(now()) @map("excluido_em")

  solicitante User?  @relation("ProjetoExcluidoSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  aprovador   User   @relation("ProjetoExcluidoAprovador",   fields: [aprovadorId],   references: [id], onDelete: Restrict)

  @@index([codigo])
  @@index([projetoIdOriginal])
  @@map("projeto_excluido")
}
